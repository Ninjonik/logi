@@ -0,0 +1,37 @@
+import { makeFunctionReference } from "convex/server"
+import { env } from "../environment"
+import { convex } from "../convex"
+
+/** One owned recipient POST. Never turn a failed receipt into permission to send again. */
+export function requestDmSender(
+    kind: "reminder" | "roster",
+    request: { id: string; fence?: number },
+    send: (userId: string, message: unknown) => Promise<boolean>
+) {
+    return async (userId: string, message: unknown) => {
+        if (request.fence === undefined)
+            throw new Error("Backend delivery protocol unavailable.")
+        const scope = {
+            secret: env.internalSecret,
+            kind,
+            requestId: request.id,
+            fence: request.fence,
+            userId,
+        }
+        const permission = (await convex.mutation(
+            makeFunctionReference<"mutation">("discordRequestDelivery:begin"),
+            scope
+        )) as { send: boolean; sent: boolean }
+        if (!permission.send) return permission.sent
+        const sent = await send(userId, message)
+        const stored = await convex.mutation(
+            makeFunctionReference<"mutation">("discordRequestDelivery:record"),
+            { ...scope, sent }
+        )
+        if (!stored)
+            throw new Error(
+                "Delivery receipt superseded; reconciliation required."
+            )
+        return sent
+    }
+}
