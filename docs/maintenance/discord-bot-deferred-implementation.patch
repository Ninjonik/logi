@@ -0,0 +1,61 @@
+import assert from "node:assert/strict"
+import { Services } from "./services"
+import test from "node:test"
+
+test("failed service start does not block independent starts, retries and stops cleanly", async (t) => {
+    t.mock.timers.enable({ apis: ["setTimeout"] })
+    let attempts = 0,
+        healthy = 0,
+        cleanups = 0,
+        stopped = 0
+    const services = new Services(() => {
+        throw Error("reporter")
+    })
+    services.start(
+        "failure",
+        async () => {
+            if (++attempts === 1) throw Error("offline")
+            return () => {
+                stopped++
+            }
+        },
+        () => {
+            cleanups++
+        }
+    )
+    services.start("healthy", () => {
+        healthy++
+        return () => {
+            stopped++
+        }
+    })
+    await new Promise((resolve) => setImmediate(resolve))
+    assert.equal(healthy, 1)
+    assert.equal(cleanups, 1)
+    t.mock.timers.tick(1000)
+    await new Promise((resolve) => setImmediate(resolve))
+    assert.equal(attempts, 2)
+    await services.stop()
+    assert.equal(stopped, 2)
+    t.mock.timers.tick(60_000)
+    assert.equal(attempts, 2)
+})
+
+test("shutdown owns a service whose asynchronous startup has not returned", async () => {
+    let release!: () => void,
+        stopped = 0
+    const services = new Services(() => {})
+    services.start("late", async () => {
+        await new Promise<void>((resolve) => {
+            release = resolve
+        })
+        return () => {
+            stopped++
+        }
+    })
+    await Promise.resolve()
+    const stop = services.stop()
+    release()
+    await stop
+    assert.equal(stopped, 1)
+})
