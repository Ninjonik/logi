+import * as delivery from "../../../convex/discordRequestDelivery"
+import * as reminders from "../../../convex/eventReminders"
+import * as changes from "../../../convex/rosterChanges"
+import { invoke, testContext } from "./testing/database"
+import assert from "node:assert/strict"
+import test from "node:test"
+
+const secret = "dev-internal-auth-secret"
+
+for (const kind of ["reminder", "roster"] as const) {
+    test(`${kind}: expired claims are discovered, receipts survive retries, stale workers cannot finish`, async (t) => {
+        const previous = process.env.INTERNAL_AUTH_SECRET
+        process.env.INTERNAL_AUTH_SECRET = secret
+        t.after(() => {
+            if (previous === undefined) delete process.env.INTERNAL_AUTH_SECRET
+            else process.env.INTERNAL_AUTH_SECRET = previous
+        })
+        const ctx = testContext()
+        const table =
+            kind === "reminder"
+                ? "eventReminderRequests"
+                : "rosterChangeRequests"
+        const module = kind === "reminder" ? reminders : changes
+        const id = `${table}:request`
+        ctx.db.seed(table, {
+            _id: id,
+            eventId: "events:e",
+            guildId: "guild",
+            status: "processing",
+            fence: 1,
+            claimedAt: "2020-01-01T00:00:00Z",
+            deliveryRecipientIds: ["player"],
+            deliveryAttemptedIds: [],
+        })
+        assert.equal(
+            (await invoke(module.listPending, ctx, { secret })).length,
+            1
+        )
+        await ctx.db.patch(id, { claimedAt: new Date().toISOString() })
+        const scope = {
+            secret,
+            kind,
+            requestId: id,
+            fence: 1,
+            userId: "player",
+        }
+        assert.equal((await invoke(delivery.begin, ctx, scope)).send, true)
+        assert.deepEqual(
+            await invoke(delivery.begin, ctx, scope),
+            { send: false, sent: false },
+            "uncertain POST is not permission to resend"
+        )
+        await assert.rejects(
+            invoke(delivery.begin, ctx, { ...scope, userId: "foreign" }),
+            /audience/
+        )
+        await ctx.db.patch(id, { fence: 2 })
+        assert.equal(
+            await invoke(delivery.record, ctx, { ...scope, sent: true }),
+            false
+        )
+        const complete =
+            kind === "reminder"
+                ? { sentCount: 1 }
+                : {
+                      dmSentUserIds: ["player"],
+                      dmFailedUserIds: [],
+                      digestPosted: true,
+                  }
+        await invoke(module.complete, ctx, {
+            secret,
+            requestId: id,
+            fence: 1,
+            ...complete,
+        })
+        const stillProcessing = await ctx.db.get(id)
+        assert.ok(stillProcessing)
+        assert.equal(stillProcessing.status, "processing")
+        await invoke(module.complete, ctx, {
+            secret,
+            requestId: id,
+            fence: 2,
+            ...complete,
+        })
+        const row = await ctx.db.get(id)
+        assert.ok(row)
+        assert.equal(row.status, "sent")
+        assert.deepEqual(row.uncertainUserIds, ["player"])
+        assert.equal(
+            kind === "reminder" ? row.sentCount : row.dmSentUserIds.length,
+            0
+        )
+    })
+}
