@@ -0,0 +1,52 @@
+import { startDurableWork } from "./durable-work"
+import assert from "node:assert/strict"
+import test from "node:test"
+
+test("overlapping watches share admission and polling discovers due claims without an update", async (t) => {
+    t.mock.timers.enable({ apis: ["setInterval"] })
+    let update!: (rows: readonly { id: string; guild: string }[]) => void
+    let reads = 0,
+        active = 0,
+        maximum = 0,
+        stopped = false
+    const releases: (() => void)[] = []
+    const rows = Array.from({ length: 20 }, (_, i) => ({
+        id: String(i),
+        guild: String(i % 5),
+    }))
+    const service = await startDurableWork({
+        read: async () => {
+            reads++
+            return reads === 1 ? [] : rows
+        },
+        watch: (callback) => {
+            update = callback
+            return () => {
+                stopped = true
+            }
+        },
+        key: (item) => item.id,
+        group: (item) => item.guild,
+        concurrency: 2,
+        process: async () => {
+            active++
+            maximum = Math.max(maximum, active)
+            await new Promise<void>((resolve) => releases.push(resolve))
+            active--
+        },
+        error: () => {},
+    })
+    t.mock.timers.tick(5000)
+    await new Promise((resolve) => setImmediate(resolve))
+    update(rows)
+    update(rows)
+    assert.equal(maximum, 2)
+    const stop = service.stop()
+    for (const release of releases) release()
+    await stop
+    assert.equal(stopped, true)
+    assert.equal(service.snapshot().active, 0)
+    assert.equal(service.snapshot().pending, 0)
+    t.mock.timers.tick(5000)
+    assert.equal(reads, 2)
+})
