new file mode 100644
--- /dev/null
+++ b/discord-bot/src/runtime/services.ts
@@ -0,0 +1,73 @@
+export type StopService = () => void | Promise<void>
+
+/** Owns independent service starts, retry timers, and stops, including stop during startup. */
+export class Services {
+    private stopped = false
+    private readonly starting = new Set<Promise<void>>()
+    private readonly stops = new Map<string, StopService>()
+    private readonly timers = new Set<ReturnType<typeof setTimeout>>()
+    constructor(
+        private readonly report: (name: string, error: unknown) => void
+    ) {}
+
+    start(
+        name: string,
+        start: () => StopService | void | Promise<StopService | void>,
+        cleanup?: StopService
+    ) {
+        let failures = 0
+        const run = () => {
+            if (this.stopped) return
+            const pending = Promise.resolve()
+                .then(start)
+                .then(async (stop) => {
+                    if (stop) {
+                        if (this.stopped) await stop()
+                        else this.stops.set(name, stop)
+                    }
+                })
+                .catch(async (error) => {
+                    try {
+                        this.report(name, error)
+                    } catch {
+                        /* Logging is not service ownership. */
+                    }
+                    try {
+                        await cleanup?.()
+                    } catch {
+                        /* Retry can reestablish the service. */
+                    }
+                    if (!this.stopped) {
+                        const timer = setTimeout(
+                            () => {
+                                this.timers.delete(timer)
+                                run()
+                            },
+                            Math.min(
+                                60_000,
+                                1000 * 2 ** Math.min(failures++, 6)
+                            )
+                        )
+                        timer.unref()
+                        this.timers.add(timer)
+                    }
+                })
+                .finally(() => {
+                    this.starting.delete(pending)
+                })
+            this.starting.add(pending)
+        }
+        run()
+    }
+
+    async stop() {
+        this.stopped = true
+        for (const timer of this.timers) clearTimeout(timer)
+        this.timers.clear()
+        await Promise.allSettled([...this.starting])
+        await Promise.allSettled(
+            [...this.stops.values()].map((stop) => Promise.resolve().then(stop))
+        )
+        this.stops.clear()
+    }
+}
