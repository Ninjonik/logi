@@ -0,0 +1,38 @@
+import type { REST, InternalRequest } from "@discordjs/rest"
+import { Admission } from "./admission"
+
+/** Separate reserved capacity keeps ACKs/private replies ahead of background reconciliation. */
+export function installDiscordAdmission(rest: Pick<REST, "queueRequest">) {
+    const background = new Admission(12, 512)
+    const interactive = new Admission(4, 128)
+    const original = rest.queueRequest.bind(rest)
+    rest.queueRequest = (request: InternalRequest) => {
+        const route = String(request.fullRoute)
+        const fast =
+            route.startsWith("/interactions/") || route.startsWith("/webhooks/")
+        const group = route.split("/").slice(0, 3).join("/")
+        const bytes = (request.files ?? []).reduce(
+            (size, file) =>
+                size +
+                (typeof file.data === "string"
+                    ? Buffer.byteLength(file.data)
+                    : typeof file.data === "object"
+                      ? file.data.byteLength
+                      : 0),
+            0
+        )
+        return (fast ? interactive : background).run(
+            () => original(request),
+            group,
+            bytes
+        )
+    }
+    return {
+        snapshot: () => ({
+            background: background.snapshot(),
+            interactive: interactive.snapshot(),
+        }),
+        stop: () =>
+            Promise.all([background.stop(), interactive.stop()]).then(() => {}),
+    }
+}
