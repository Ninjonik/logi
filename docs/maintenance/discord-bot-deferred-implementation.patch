+import assert from "node:assert/strict"
+import { Admission } from "./admission"
+import test from "node:test"
+
+test("actual I/O slots survive response timeouts and rotate across groups", async () => {
+    const gate = new Admission(1, 10)
+    let release!: () => void
+    const calls: string[] = []
+    const first = gate.run(async () => {
+        await new Promise<void>((resolve) => {
+            release = resolve
+        })
+    }, "hot")
+    await Promise.resolve()
+    const rest = [
+        gate.run(async () => {
+            calls.push("hot")
+        }, "hot"),
+        gate.run(async () => {
+            calls.push("cold")
+        }, "cold"),
+    ]
+    assert.equal(gate.snapshot().active, 1)
+    release()
+    await first
+    await Promise.all(rest)
+    assert.deepEqual(calls, ["cold", "hot"])
+    assert.equal(gate.snapshot().maxActive, 1)
+})
+test("admission bounds retained bytes and shutdown rejects queued work before draining", async () => {
+    const gate = new Admission(1, 2, 10)
+    let release!: () => void
+    const first = gate.run(
+        () =>
+            new Promise<void>((resolve) => {
+                release = resolve
+            }),
+        "a",
+        6
+    )
+    await Promise.resolve()
+    await assert.rejects(
+        gate.run(async () => {}, "b", 5),
+        /admission/
+    )
+    const next = gate.run(async () => {}, "b", 4)
+    const rejected = assert.rejects(next, /stopped/)
+    const stopping = gate.stop()
+    await rejected
+    assert.equal(gate.snapshot().bytes, 6)
+    release()
+    await first
+    await stopping
+    assert.equal(gate.snapshot().bytes, 0)
+})
