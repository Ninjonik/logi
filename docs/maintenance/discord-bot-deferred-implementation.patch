new file mode 100644
--- /dev/null
+++ b/convex/discordRequestDelivery.ts
@@ -0,0 +1,72 @@
+import { assertInternalSecret } from "./discord_shared"
+import { mutation } from "./_generated/server"
+import { v } from "convex/values"
+
+const args = {
+    secret: v.string(),
+    kind: v.union(v.literal("reminder"), v.literal("roster")),
+    requestId: v.string(),
+    fence: v.number(),
+    userId: v.string(),
+}
+
+/** Reserve before the external POST. An interrupted/ambiguous recipient is not blindly replayed. */
+export const begin = mutation({
+    args,
+    handler: async (ctx, input) => {
+        assertInternalSecret(input.secret)
+        const id =
+            input.kind === "reminder"
+                ? ctx.db.normalizeId("eventReminderRequests", input.requestId)
+                : ctx.db.normalizeId("rosterChangeRequests", input.requestId)
+        const row = id ? await ctx.db.get(id) : null
+        if (
+            !row ||
+            row.status !== "processing" ||
+            row.fence !== input.fence ||
+            Date.parse(row.claimedAt ?? "") + 300_000 <= Date.now()
+        )
+            throw new Error("Delivery claim expired or superseded.")
+        if (!row.deliveryRecipientIds?.includes(input.userId))
+            throw new Error("Recipient outside claimed audience.")
+        if (row.deliveryAttemptedIds?.includes(input.userId))
+            return {
+                send: false,
+                sent: row.deliverySentIds?.includes(input.userId) === true,
+            }
+        await ctx.db.patch(row._id, {
+            deliveryAttemptedIds: [
+                ...(row.deliveryAttemptedIds ?? []),
+                input.userId,
+            ],
+            // Admitted work renews its own lease; queued work never owns one.
+            claimedAt: new Date().toISOString(),
+        })
+        return { send: true, sent: false }
+    },
+})
+
+export const record = mutation({
+    args: { ...args, sent: v.boolean() },
+    handler: async (ctx, input) => {
+        assertInternalSecret(input.secret)
+        const id =
+            input.kind === "reminder"
+                ? ctx.db.normalizeId("eventReminderRequests", input.requestId)
+                : ctx.db.normalizeId("rosterChangeRequests", input.requestId)
+        const row = id ? await ctx.db.get(id) : null
+        if (
+            !row ||
+            row.status !== "processing" ||
+            row.fence !== input.fence ||
+            !row.deliveryAttemptedIds?.includes(input.userId)
+        )
+            return false
+        const field = input.sent ? "deliverySentIds" : "deliveryFailedIds"
+        await ctx.db.patch(row._id, {
+            [field]: [...new Set([...(row[field] ?? []), input.userId])],
+            claimedAt: new Date().toISOString(),
+        })
+        return true
+    },
+})
