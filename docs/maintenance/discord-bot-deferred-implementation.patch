--- /dev/null
+++ b/discord-bot/src/runtime/durable-work.ts
@@ -0,0 +1,65 @@
+import { WorkQueue } from "./work-queue"
+
+/** Watches plus periodically discovers due work; wall-clock lease expiry is not a subscription event. */
+export async function startDurableWork<T>(ports: {
+    read(): Promise<readonly T[]>
+    watch(update: (rows: readonly T[]) => void): () => void
+    key(item: T): string
+    group(item: T): string
+    process(item: T): Promise<void>
+    error(error: unknown): void
+    concurrency?: number
+    pollMs?: number
+}) {
+    const queue = new WorkQueue({
+        concurrency: ports.concurrency ?? 4,
+        capacity: 256,
+        onError: ports.error,
+    })
+    let stopped = false
+    let reading: Promise<void> | undefined
+    const admit = (rows: readonly T[]) => {
+        if (stopped) return
+        for (const item of rows)
+            queue.enqueue(
+                ports.key(item),
+                () => ports.process(item),
+                ports.group(item)
+            )
+    }
+    const report = (error: unknown) => {
+        try {
+            ports.error(error)
+        } catch {
+            /* Reporting never breaks lifecycle. */
+        }
+    }
+    const poll = () => {
+        reading ??= Promise.resolve()
+            .then(ports.read)
+            .then(admit)
+            .catch(report)
+            .finally(() => {
+                reading = undefined
+            })
+        return reading
+    }
+    const unsubscribe = ports.watch(admit)
+    const timer = setInterval(() => {
+        void poll()
+    }, ports.pollMs ?? 5000)
+    timer.unref()
+    await poll()
+    return {
+        snapshot: () => queue.snapshot(),
+        async stop() {
+            stopped = true
+            clearInterval(timer)
+            try {
+                unsubscribe()
+            } finally {
+                await Promise.all([queue.stop(), reading])
+            }
+        },
+    }
+}
