@@ -0,0 +1,115 @@
+type Pending = {
+    group: string
+    bytes: number
+    run(): void
+    reject(error: Error): void
+    queuedAt: number
+}
+
+/** Actual I/O capacity, retained until settlement even if its caller races a timeout. */
+export class Admission {
+    private active = 0
+    private bytes = 0
+    private readonly pending: Pending[] = []
+    private readonly idle = new Set<() => void>()
+    private stopped = false
+    private lastGroup?: string
+    private readonly totals = {
+        started: 0,
+        finished: 0,
+        rejected: 0,
+        maxActive: 0,
+        waitMs: 0,
+    }
+    constructor(
+        private readonly concurrency: number,
+        private readonly capacity = 1024,
+        private readonly maxBytes = 64 * 1024 * 1024
+    ) {
+        if (!Number.isSafeInteger(concurrency) || concurrency < 1)
+            throw Error("Invalid I/O concurrency")
+    }
+    run<T>(
+        operation: () => Promise<T>,
+        group = "default",
+        bytes = 0
+    ): Promise<T> {
+        if (
+            this.stopped ||
+            this.pending.length >= this.capacity ||
+            bytes > this.maxBytes ||
+            this.bytes + bytes > this.maxBytes
+        ) {
+            this.totals.rejected++
+            return Promise.reject(
+                Error(
+                    "I/O admission unavailable; retry through the owning workflow."
+                )
+            )
+        }
+        return new Promise<T>((resolve, reject) => {
+            this.bytes += bytes
+            this.pending.push({
+                group,
+                bytes,
+                reject,
+                queuedAt: Date.now(),
+                run: () => {
+                    this.active++
+                    this.totals.started++
+                    this.totals.maxActive = Math.max(
+                        this.totals.maxActive,
+                        this.active
+                    )
+                    void Promise.resolve()
+                        .then(operation)
+                        .then(resolve, reject)
+                        .finally(() => {
+                            this.active--
+                            this.bytes -= bytes
+                            this.totals.finished++
+                            this.pump()
+                            if (!this.active && !this.pending.length) {
+                                for (const done of this.idle) done()
+                                this.idle.clear()
+                            }
+                        })
+                },
+            })
+            this.pump()
+        })
+    }
+    private pump() {
+        while (
+            !this.stopped &&
+            this.active < this.concurrency &&
+            this.pending.length
+        ) {
+            const different = this.pending.findIndex(
+                (entry) => entry.group !== this.lastGroup
+            )
+            const [next] = this.pending.splice(different < 0 ? 0 : different, 1)
+            this.lastGroup = next.group
+            this.totals.waitMs += Date.now() - next.queuedAt
+            next.run()
+        }
+    }
+    snapshot() {
+        return {
+            ...this.totals,
+            active: this.active,
+            queued: this.pending.length,
+            bytes: this.bytes,
+        }
+    }
+    stop(): Promise<void> {
+        this.stopped = true
+        for (const entry of this.pending.splice(0)) {
+            this.bytes -= entry.bytes
+            entry.reject(Error("I/O admission stopped."))
+        }
+        return this.active
+            ? new Promise((resolve) => this.idle.add(resolve))
+            : Promise.resolve()
+    }
+}
